{
  "name": "electron-textfile",
  "version": "1.0.0",
  "private": true,
  "description": "TaskWall - Create an image with your todo list on a blue background",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.taskwall.app",
    "productName": "TaskWall",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    },
    "mac": {
      "target": ["dmg", "zip"]
    }
  },
  "dependencies": {
    "electron": "^31.3.1",
    "sharp": "^0.33.5",
    "wallpaper": "^7.2.1"
  },
  "devDependencies": {
    "electron-builder": "^26.15.3"
  }
}
