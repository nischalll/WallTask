{
  "name": "taskwall",
  "desktopName": "Taskwall",
  "version": "1.0.2",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "TaskWall - Create an image with your todo list on a blue background",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.taskwall.app",
    "productName": "Taskwall",
    "icon": "src/assets/icon.png",
    "asarUnpack": [
      "**/node_modules/@img/**/*",
      "**/node_modules/sharp/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "executableName": "Taskwall",
      "icon": "src/assets/icons",
      "desktop": {
        "entry": {
          "StartupWMClass": "Taskwall"
        }
      },
      "maintainer": "Nischal Nandurkar <nischalnischal6@gmail.com>"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "author": {
    "name": "Nischal Nandurkar",
    "email": "nischalnischal6@gmail.com"
  },
  "dependencies": {
    "sharp": "^0.33.5",
    "wallpaper": "^7.2.1"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^26.15.3",
    "tslib": "^2.8.1"
  }
}
